# =============================================================================
# My-Invest Dashboard - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# DO NOT commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Backend Configuration
# -----------------------------------------------------------------------------

# Server binding configuration
HOST=0.0.0.0
PORT=8080

# Database connections
DATABASE_URL=mongodb://localhost:27017/myinvest
REDIS_URL=redis://localhost:6379

# Frontend URL for CORS configuration
FRONTEND_URL=http://localhost:3000

# Logging level (trace, debug, info, warn, error)
RUST_LOG=info

# Enable backtrace for debugging (0 or 1)
RUST_BACKTRACE=0

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------

# API endpoints for frontend
VITE_API_BASE_URL=http://localhost:8080/api
VITE_WS_URL=ws://localhost:8080/ws

# Node environment
NODE_ENV=development

# -----------------------------------------------------------------------------
# Database Configuration (for Docker)
# -----------------------------------------------------------------------------

# MongoDB
MONGO_INITDB_DATABASE=myinvest

# -----------------------------------------------------------------------------
# External API Keys (to be added when integrating market data)
# -----------------------------------------------------------------------------

# Alpha Vantage API
# ALPHA_VANTAGE_API_KEY=your_api_key_here

# Finnhub API
# FINNHUB_API_KEY=your_api_key_here

# CoinGecko API (if using pro version)
# COINGECKO_API_KEY=your_api_key_here

# -----------------------------------------------------------------------------
# JWT Configuration (for authentication)
# -----------------------------------------------------------------------------

# JWT secret key (generate a strong random string)
# JWT_SECRET=your_super_secret_key_here

# JWT expiration time in hours
# JWT_EXPIRATION_HOURS=24

# -----------------------------------------------------------------------------
# Development Tools (only for docker-compose.dev.yml)
# -----------------------------------------------------------------------------

# Mongo Express credentials
ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD=admin
