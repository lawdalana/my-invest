# =============================================================================
# My-Invest Backend Configuration
# =============================================================================
# Copy this file to .env and update the values for your environment.
# NEVER commit the .env file to version control!
# =============================================================================

# =============================================================================
# Server Configuration
# =============================================================================
# Host address to bind the server to (0.0.0.0 for all interfaces)
SERVER_HOST=0.0.0.0

# Port number for the HTTP server
SERVER_PORT=8080

# Environment (development, staging, production)
ENVIRONMENT=development

# =============================================================================
# Logging Configuration
# =============================================================================
# Rust log level (trace, debug, info, warn, error)
# Format: RUST_LOG=my_invest_backend=debug,tower_http=debug,axum=info
RUST_LOG=info,my_invest_backend=debug,tower_http=debug

# =============================================================================
# JWT Authentication
# =============================================================================
# Secret key for signing JWT tokens (use a long, random string in production)
# Generate with: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Access token expiration in seconds (default: 1 hour)
JWT_ACCESS_EXPIRATION=3600

# Refresh token expiration in seconds (default: 30 days)
JWT_REFRESH_EXPIRATION=2592000

# JWT issuer claim
JWT_ISSUER=my-invest-api

# =============================================================================
# MongoDB Configuration
# =============================================================================
# MongoDB connection URI
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://username:password@cluster.mongodb.net
MONGODB_URI=mongodb://localhost:27017

# Database name
MONGODB_DATABASE=my_invest

# Connection pool settings
MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_POOL_SIZE=20

# =============================================================================
# Redis Configuration
# =============================================================================
# Redis connection URL
# Local: redis://localhost:6379
# With password: redis://:password@localhost:6379
# Upstash: rediss://default:password@hostname:6379
REDIS_URL=redis://localhost:6379

# Default cache TTL in seconds (5 minutes)
REDIS_CACHE_TTL=300

# Historical data cache TTL in seconds (1 hour)
REDIS_HISTORY_CACHE_TTL=3600

# =============================================================================
# Alpha Vantage API
# =============================================================================
# API key from https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key

# Base URL for Alpha Vantage API
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query

# Rate limit: requests per minute (free tier = 5)
ALPHA_VANTAGE_RATE_LIMIT=5

# Daily request limit (free tier = 500)
ALPHA_VANTAGE_DAILY_LIMIT=500

# =============================================================================
# Rate Limiting
# =============================================================================
# Maximum requests per window
RATE_LIMIT_REQUESTS=100

# Rate limit window in seconds
RATE_LIMIT_WINDOW=60

# =============================================================================
# CORS Configuration
# =============================================================================
# Comma-separated list of allowed origins
# Example: http://localhost:3000,http://localhost:5173,https://myapp.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# =============================================================================
# Application Settings
# =============================================================================
# Maximum watchlists per user
MAX_WATCHLISTS_PER_USER=20

# Maximum assets per watchlist
MAX_ASSETS_PER_WATCHLIST=50

# Minimum password length
MIN_PASSWORD_LENGTH=8
