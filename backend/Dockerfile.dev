# =============================================================================
# My-Invest Backend - Development Dockerfile
# =============================================================================
# Development image with hot reload support using cargo-watch
# =============================================================================

FROM rust:1.75-bookworm

# Install build dependencies and development tools
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install cargo-watch for hot reloading
RUN cargo install cargo-watch

WORKDIR /app

# Copy Cargo files
COPY Cargo.toml Cargo.lock* ./

# Create a dummy main.rs to download dependencies
RUN mkdir src && echo "fn main() {}" > src/main.rs

# Download dependencies (this layer will be cached)
RUN cargo build && rm -rf src

# Expose the port
EXPOSE 8080

# Set environment variables for development
ENV RUST_LOG=debug,my_invest_backend=debug,tower_http=debug
ENV RUST_BACKTRACE=1
ENV ENVIRONMENT=development

# Use cargo-watch for hot reloading
# -x run: run the application
# -w src: watch the src directory
# --poll: use polling for file changes (better for Docker)
CMD ["cargo", "watch", "-x", "run", "-w", "src", "--poll"]
