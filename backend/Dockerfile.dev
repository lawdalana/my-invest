# Development Dockerfile for My-Invest Backend
# Uses cargo-watch for hot reload during development

FROM rust:latest

# Install build dependencies and development tools
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install cargo-watch for hot reload
RUN cargo install cargo-watch

# Set working directory
WORKDIR /app

# Copy manifests first for dependency caching
COPY Cargo.toml ./

# Create dummy source to build dependencies
RUN mkdir -p src && \
    echo 'fn main() { println!("Dummy"); }' > src/main.rs && \
    cargo build && \
    rm -rf src

# Copy source code (will be overwritten by volume mount in dev)
COPY . .

# Expose the API port
EXPOSE 8080

# Set environment variables for development
ENV HOST=0.0.0.0
ENV PORT=8080
ENV RUST_LOG=debug
ENV RUST_BACKTRACE=1

# Run with cargo-watch for hot reload
# -x run: execute "cargo run" on file changes
# -w src: watch the src directory
# -q: quiet mode (reduce noise)
CMD ["cargo", "watch", "-x", "run", "-w", "src"]
